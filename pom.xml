<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        根聚合父工程（Aggregator + Parent 二合一）：
        1. packaging=pom 表示它只做模块聚合与版本管理，不打 jar
        2. 继承 Spring Boot parent，把依赖/plugin 版本管理传递给所有子模块
        3. 子模块只需把 parent 指向本项目，即可统一 Java / 依赖版本
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.0.11</version>
        <relativePath/> <!-- 从仓库解析，不从本地路径找 -->
    </parent>

    <groupId>org.twiglau</groupId>
    <artifactId>lease</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>lease</name>
    <description>lease 学习项目 - 多模块聚合父工程</description>

    <!-- 所有子服务模块；将来新增服务只需在此加一行 <module>xxx</module> -->
    <modules>
        <module>hello-mp</module>
        <module>hello-minio</module>
        <module>hello-knife4j</module>
        <module>model</module>
        <module>common</module>
        <module>web</module>
    </modules>

    <properties>
        <java.version>17</java.version>

        <!-- 数据访问：教程的 3.5.3.1 没有 boot3 starter，升级为 3.5.4 -->
        <mybatis-plus.version>3.5.4</mybatis-plus.version>
        <!-- JWT：0.11.x 拆成 api / impl / jackson 三件套 -->
        <jwt.version>0.11.2</jwt.version>
        <!-- 图形验证码 -->
        <easycaptcha.version>1.6.2</easycaptcha.version>
        <!-- MinIO：教程的 8.2.0 可用，8.5.x 对 JDK17 / 新版 okhttp 适配更好 -->
        <minio.version>8.5.17</minio.version>
        <!-- Knife4j：Spring Boot 3 只能用 jakarta + OpenAPI3 的 starter，4.4.0 兼容 3.0.x -->
        <knife4j.version>4.4.0</knife4j.version>
        <!-- 阿里云短信：2.0.23 与教程代码里的 SendSms 调用方式一致 -->
        <aliyun.sms.version>2.0.23</aliyun.sms.version>
        <!-- AWS SDK 版本：2.20.0 与 Spring Boot 3.0.11 / MinIO 2025-04 同代际，签名兼容 -->
        <aws.sdk.version>2.20.0</aws.sdk.version>
        <hutool.version>5.8.28</hutool.version>
        <flyway.version>9.5.1</flyway.version>
    </properties>

    <!--
        依赖版本统一管理：这里只声明版本，不真正引入依赖。
        子模块在 <dependencies> 中正常声明即可继承版本。
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!--
                Knife4j starter：已内置 springdoc-openapi，子模块不要再单独引入 springdoc。
                教程里的 springfox-swagger2 2.9.2 基于 javax.servlet，Spring Boot 3 无法使用，
                这里用 Knife4j OpenAPI3 版本替代。
            -->
            <dependency>
                <groupId>com.github.xiaoymin</groupId>
                <artifactId>knife4j-openapi3-jakarta-spring-boot-starter</artifactId>
                <version>${knife4j.version}</version>
            </dependency>

            <!-- JWT：运行时只需要 jjwt-impl + jjwt-jackson，api 用于编译 -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jwt.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!-- 图形验证码 -->
            <dependency>
                <groupId>com.github.whvcse</groupId>
                <artifactId>easy-captcha</artifactId>
                <version>${easycaptcha.version}</version>
            </dependency>

            <!-- MinIO 客户端 -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>

            <!-- 阿里云短信 SDK -->
            <dependency>
                <groupId>com.aliyun</groupId>
                <artifactId>dysmsapi20170525</artifactId>
                <version>${aliyun.sms.version}</version>
            </dependency>
            <!-- AWS SDK v2 BOM：统一管理 s3 / presigner 等所有模块版本 -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${aws.sdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- hutool工具类, 用于简化开发-->
            <!-- 官方文档：https://hutool.cn/docs/ -->
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-all</artifactId>
                <version>${hutool.version}</version>
            </dependency>
            <!--数据库管理-->
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-core</artifactId>
                <version>${flyway.version}</version>
            </dependency>
            <dependency>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-mysql</artifactId>
                <version>${flyway.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!--
                关键：项目级 JDK 隔离。
                全局 ~/.zshrc 把 JAVA_HOME 锁死在 Java 8（为 public_chain 老项目服务），
                但本项目要求 Java 17。这里用 Toolchains 强制编译使用 JDK 17，
                不改全局 JAVA_HOME，两个项目互不干扰。
                依赖 JDK 注册在 ~/.m2/toolchains.xml。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-toolchains-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>toolchain</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <toolchains>
                        <jdk>
                            <version>17</version>
                            <vendor>oracle</vendor>
                        </jdk>
                    </toolchains>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>

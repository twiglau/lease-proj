<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.twiglau.lease.web.admin.mapper.AttrKeyMapper">

    <resultMap id="AttrKeyVo" type="org.twiglau.lease.web.admin.vo.attr.AttrKeyVo">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <collection property="attrValueList" ofType="org.twiglau.lease.model.entity.AttrValue">
            <id column="attr_value_id" property="id"/>
            <result column="attr_value_name" property="name"/>
            <result column="attr_key_id" property="attrKeyId"/>
        </collection>
    </resultMap>

    <!--查询全部属性key value信息-->
<!--    注意：-->
<!--    - LEFT JOIN 使用是以atrrKey为主，防止没有配置对应atrrValue而查不到对应atrrKey,-->
<!--      能保证JOIN之后，包含左表的全部数据 （FROM attr_key ak LEFT JOIN attr_value av ON ak.id = av.attr_key_id）-->
<!--      并不能保证这条SQL语句执行之后，包含左表的全部数据（注意还有查询条件）-->

    <select id="listAttrInfo" resultMap="AttrKeyVo">
        SELECT ak.id,
               ak.name,
               av.id   AS attr_value_id,
               av.name AS attr_value_name,
               av.attr_key_id AS attr_key_id
        FROM attr_key ak
                 LEFT JOIN attr_value av
                     ON ak.id = av.attr_key_id AND av.is_deleted = 0
        WHERE ak.is_deleted = 0;
    </select>
</mapper>

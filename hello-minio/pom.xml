<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- parent 指向根聚合父工程，groupId/version/依赖版本全部继承 -->
    <parent>
        <groupId>org.twiglau</groupId>
        <artifactId>lease</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>hello-minio</artifactId>
    <name>hello-minio</name>
    <description>对象存储演练示例服务（AWS SDK v2 S3 客户端连接 MinIO）</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!-- S3 客户端（S3Presigner 也在本模块内，无需单独依赖）；版本由父 pom 的 BOM 管理 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <exclusions>
                <!--
                    排除默认的 apache-client：它依赖 httpclient5，
                    而 Spring Boot 3.0.11 把 httpclient5 锁在 5.1.4，与较新 AWS SDK 存在版本冲突。
                    改用下面的 url-connection-client（JDK 内置实现，无第三方依赖）。
                -->
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>apache-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 轻量 HTTP 实现：基于 JDK HttpURLConnection，无第三方 httpclient 版本冲突 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
